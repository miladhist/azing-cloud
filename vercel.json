{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/playbook/xau-001", "destination": "/playbook/xau-001/index.html" },
    { "source": "/playbook/xau-002", "destination": "/playbook/xau-002/index.html" },
    { "source": "/playbook/btc-001", "destination": "/playbook/btc-001/index.html" },
    { "source": "/playbook/xag-001", "destination": "/playbook/xag-001/index.html" }
  ],
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    { "source": "/worldcup/(.*)", "headers": [
      { "key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src 'self' http://76.13.148.202:3456; frame-ancestors 'none'" }
    ]},
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ]}
  ]
}
