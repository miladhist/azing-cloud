{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/worldcup-api/:path*", "destination": "http://76.13.148.202:3456/api/:path*" },
    { "source": "/playbook/xau-001", "destination": "/playbook/xau-001/index.html" },
    { "source": "/playbook/xau-002", "destination": "/playbook/xau-002/index.html" },
    { "source": "/playbook/btc-001", "destination": "/playbook/btc-001/index.html" },
    { "source": "/playbook/xag-001", "destination": "/playbook/xag-001/index.html" }
  ],
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
